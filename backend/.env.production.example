# En el server: copiar a backend/.env (no se sube) y completar. Lo lee docker-compose.yml.

# --- Obligatorias ---
# Generar con: openssl rand -hex 32
JWT_SECRET=CAMBIAR
# URL del frontend en Vercel (sin / al final)
CORS_ORIGIN=https://tu-app.vercel.app
# Postgres compartido: el host es el nombre del contenedor de Postgres en la red `db`
DATABASE_URL=postgres://USUARIO:CLAVE@NOMBRE_CONTENEDOR_POSTGRES:5432/BASE

# --- Recomendadas ---
# true si hay Nginx/Caddy/Cloudflare delante (para HTTPS/WSS)
TRUST_PROXY=true
LOG_LEVEL=info
# Puerto del server donde queda expuesto el backend (3000, 8000 y 8080 ya están ocupados)
HOST_PORT=3001
