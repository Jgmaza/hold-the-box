# Copiar a .env (no se sube). Defaults de desarrollo en backend/src/config/env.js.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=15m
GUEST_JWT_EXPIRES_IN=1d
REFRESH_TTL_DAYS=30
CORS_ORIGIN=*

# Seguridad (#9). RATE_LIMIT_SKIP_LOCAL: por defecto true fuera de producción (127.0.0.1 sin límites por IP).
TRUST_PROXY=false
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
MAX_CONNECTIONS=2000
WS_UPGRADES_PER_SEC=3
WS_ABUSE_CLOSE_MS=5000

# Tiempo real
TICK_HZ=60
SNAPSHOT_HZ=30
HEARTBEAT_MS=15000
PRESENCE_TTL_SEC=60
INVITE_TTL_SEC=120
INVITES_PER_MINUTE=10

# Salas / partida
MAX_DUOS_DEFAULT=4
COUNTDOWN_MS=3000
RESULTS_MS=10000
MATCH_TIME_LIMIT_SEC=300
SPAWN_GHOST_SEC=2
RECONNECT_GRACE_MS=30000
MAX_SPECTATORS=8

# Datos (docker compose up -d). Sin estas dos, el server corre en memoria.
DATABASE_URL=postgres://htb:htb@localhost:5432/htb
REDIS_URL=redis://localhost:6379
